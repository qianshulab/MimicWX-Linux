# Address exposed by Docker. Keep 127.0.0.1 when using a reverse proxy or SSH tunnel.
MIMICWX_BIND_IP=127.0.0.1

# Local image tag built from this repository.
MIMICWX_IMAGE=local/mimicwx-linux:0.6.0

# Keep live credentials outside the tracked config.toml template.
MIMICWX_CONFIG_FILE=./config.local.toml
